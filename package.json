{
  "name": "maya",
  "version": "1.0.0",
  "description": "MAYA AI Chatbot - A modern, modular AI chatbot interface built with Python and PyQt6",
  "main": "maya_web_interface/app.py",
  "type": "module",
  "scripts": {
    "start": "python -m maya_web_interface.app",
    "dev": "nodemon --watch maya_web_interface --exec python -m maya_web_interface.app",
    "build:css": "postcss maya_web_interface/static/css/src/styles.css -o maya_web_interface/static/css/styles.css --config ./",
    "watch:css": "postcss maya_web_interface/static/css/src/styles.css -o maya_web_interface/static/css/styles.css --watch --config ./",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,html,css}\"",
    "lint": "eslint maya_web_interface/static/js/**/*.js",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shaayar/Maya.git"
  },
  "keywords": [
    "ai",
    "chatbot",
    "python",
    "pyqt6",
    "web-interface"
  ],
  "author": "Shubh Patel",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/shaayar/Maya/issues"
  },
  "homepage": "https://github.com/shaayar/Maya#readme",
  "dependencies": {
    "@tailwindcss/forms": "^0.5.3",
    "@tailwindcss/typography": "^0.5.9",
    "alpinejs": "^3.12.3",
    "autoprefixer": "^10.4.15",
    "gsap": "^3.12.2",
    "postcss": "^8.4.27",
    "postcss-cli": "^10.1.0",
    "tailwindcss": "^3.3.3"
  },
  "devDependencies": {
    "@babel/core": "^7.22.10",
    "@babel/preset-env": "^7.22.10",
    "eslint": "^8.47.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react": "^7.33.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.6.2",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.2"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
